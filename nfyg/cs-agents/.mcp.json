{
  "mcpServers": {
    "notion": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${NOTION_API_KEY}\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },
    "nfyg_admin_mcp": {
      "type": "http",
      "url": "https://nfyg-admin-kq34ngdawq-an.a.run.app/mcp",
      "headers": {
        "X-NAO-Token": "${WORKSHOP_MCP_SECRET}"
      }
    },
    "dbhub": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--dsn",
        "${DBHUB_DSN_NETFLIX_SALON}",
        "--read-only"
      ]
    }
  }
}
